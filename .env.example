# Servidor de tracking de MLflow: con make server se usa http://127.0.0.1:5000; sin la variable el código toma la base local sqlite:///mlflow.db
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Servicio de predicción (api/): si RUTA_MODELO apunta a la carpeta del modelo exportado con make exportar-modelo, se carga de ahí y no del registry
# RUTA_MODELO=models/api

# Sistema con Docker Compose (docker-compose.yml). Compose lee .env solo para sustituir las variables de abajo; todas tienen el mismo valor por defecto en docker-compose.yml, así que .env es opcional. Dentro del sistema el servicio usa siempre http://mlflow:5000, no la variable MLFLOW_TRACKING_URI de arriba
# Puertos que se publican en 127.0.0.1
MLFLOW_PUERTO=5000
API_PUERTO=8000
# Procesos de uvicorn, peticiones que cada proceso atiende a la vez (1 las atiende de una en una, que es lo que mejor rindió en la prueba de carga; 0 deja los 40 hilos de Starlette) y límites de CPU y memoria del contenedor del servicio de predicción
API_PROCESOS=1
API_HILOS=1
API_CPUS=1.0
API_MEMORIA=1g
# Procesos y límites del servidor de MLflow
MLFLOW_PROCESOS=1
MLFLOW_CPUS=1.0
MLFLOW_MEMORIA=768m
# Prueba de carga (perfil carga): versión de la imagen de Locust y límites del generador
LOCUST_VERSION=2.47.0
LOCUST_CPUS=2.0
LOCUST_MEMORIA=1g
# Escenario de la prueba de carga: prefijo de los archivos de reports/carga, usuarios por escalón, segundos por escalón, segundos de calentamiento que se descartan en cada uno y estaciones por lote; los cuatro últimos, vacíos, toman los valores de carga/locustfile.py
CARGA_NOMBRE=carga
CARGA_ESCALONES=
CARGA_DURACION=
CARGA_CALENTAMIENTO=
CARGA_TAMANO_LOTE=
