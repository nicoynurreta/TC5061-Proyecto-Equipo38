name: mibici-equipo38

python_env: python_env.yaml

entry_points:
  ingest:
    parameters:
      months: {type: string, default: ""}
    command: "python -m mibici.dataset --meses {months}"

  train:
    parameters:
      question: {type: string}
      model: {type: string}
      run_name: {type: string, default: ""}
    command: "python -m mibici.modeling.train --pregunta {question} --modelo {model} --nombre_corrida {run_name}"

  search:
    parameters:
      question: {type: string}
      model: {type: string}
      run_name: {type: string, default: ""}
    command: "python -m mibici.modeling.search --pregunta {question} --modelo {model} --nombre_corrida {run_name}"

  ingest_actual:
    parameters:
      months: {type: string, default: ""}
    command: "python -m mibici.monitoreo.datos --ingerir --meses {months}"

  monitor:
    parameters:
      version: {type: string, default: ""}
    command: "python -m mibici.monitoreo.datos --exportar --version {version} && python -m mibici.monitoreo.drift --registrar && python -m mibici.monitoreo.desempeno"

  reentrenar:
    parameters:
      run_name: {type: string, default: ""}
    command: "python -m mibici.modeling.reentrenar --nombre_corrida {run_name}"

  abtest:
    parameters:
      version_a: {type: string, default: ""}
      version_b: {type: string, default: ""}
      promote: {type: string, default: ""}
    command: "python -m mibici.modeling.abtest --version_a {version_a} --version_b {version_b} --promover {promote}"
