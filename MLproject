name: mibici-equipo38

python_env: python_env.yaml

entry_points:
  ingest:
    parameters:
      months: {type: string, default: ""}
    command: "python -m mibici.dataset --meses {months}"

  train:
    parameters:
      question: {type: string}
      model: {type: string}
      run_name: {type: string, default: ""}
    command: "python -m mibici.modeling.train --pregunta {question} --modelo {model} --nombre_corrida {run_name}"

  search:
    parameters:
      question: {type: string}
      model: {type: string}
      run_name: {type: string, default: ""}
    command: "python -m mibici.modeling.search --pregunta {question} --modelo {model} --nombre_corrida {run_name}"
